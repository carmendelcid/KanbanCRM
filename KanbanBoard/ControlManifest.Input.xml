<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="KanbanCRM" constructor="KanbanBoard" version="1.0.8" display-name-key="KanbanBoard" description-key="KanbanBoard description" control-type="standard" >
    
    <external-service-usage enabled="false">
    </external-service-usage>
    
    <data-set name="tasksDataset" display-name-key="Dataset de Tareas" description-key="Dataset que contiene las tareas">
      
      <property-set name="titleProperty" display-name-key="Columna de Título" description-key="Selecciona la columna que actúa como título" of-type="SingleLine.Text" usage="bound" required="true" />
      
      <property-set name="statusProperty" display-name-key="Columna de Estado" description-key="Selecciona la columna que actúa como estado" of-type="SingleLine.Text" usage="bound" required="true" />
      
      <property-set name="repoProperty" display-name-key="Columna de Repositorio GitHub" description-key="Selecciona la columna que contiene la URL al repositorio" of-type="SingleLine.URL" usage="bound" required="false" />
      
    </data-set>

    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    
    <resources>
      <code path="index.ts" order="1"/>
    </resources>
    
  </control>
</manifest>